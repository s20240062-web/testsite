<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>おにぎりキャッチ</title>
<style>
:root{--bg1:#ffe9b8;--bg2:#ffb36b;--ink:#4a2a12;--card:#fffaf0;--accent:#e8452c;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg1:#2b1b4a;--bg2:#6a3a7a;--ink:#fff1dc;--card:#3a2560;--accent:#ff7a59;color-scheme:dark}}
:root[data-theme="dark"]{--bg1:#2b1b4a;--bg2:#6a3a7a;--ink:#fff1dc;--card:#3a2560;--accent:#ff7a59;color-scheme:dark}
html,body{height:100%;margin:0;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;font-family:"Hiragino Sans","Noto Sans JP",sans-serif;background:var(--bg1);color:var(--ink)}
#wrap{position:relative;width:100%;height:100%;background:linear-gradient(var(--bg1),var(--bg2))}
canvas{display:block;width:100%;height:100%}
#ov{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
#card{background:var(--card);padding:24px 36px;border-radius:24px;text-align:center;box-shadow:0 8px 30px #0004;max-width:80%}
#card h1{margin:0 0 8px;font-size:34px}
#card p{margin:6px 0;font-size:17px;line-height:1.5}
#card b{display:inline-block;margin-top:10px;padding:12px 32px;border-radius:999px;background:var(--accent);color:#fff;font-size:20px}
</style>
</head>
<body>
<div id="wrap">
<canvas id="cv"></canvas>
<div id="ov"><div id="card">
<h1>🍙 おにぎりキャッチ 🧺</h1>
<p>指でかごを左右に動かして<br>🍙(+1) 🍣(+5) をキャッチ!<br>💣 にあたるとライフが減るよ</p>
<p id="best"></p>
<b>タップでスタート</b>
</div></div>
</div>
<script>
const cv=document.getElementById('cv'),ctx=cv.getContext('2d'),ov=document.getElementById('ov'),card=document.getElementById('card');
let W,H,dpr;
function resize(){dpr=window.devicePixelRatio||1;W=cv.clientWidth;H=cv.clientHeight;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}
addEventListener('resize',resize);resize();

let best=0;
try{best=+localStorage.getItem('onigiri-best')||0}catch(e){}
const bestEl=document.getElementById('best');
function showBest(){bestEl.textContent=best?'ハイスコア: '+best:''}showBest();

let running=false,items=[],pops=[],px=0,tx=0,score=0,lives=3,combo=0,t=0,spawn=0,last=0,shake=0;
const TYPES=[{e:'🍙',w:70,pts:1},{e:'🍣',w:12,pts:5},{e:'💣',w:18,pts:0,bomb:true}];

function pick(){let r=Math.random()*100;for(const k of TYPES){if((r-=k.w)<0)return k}return TYPES[0]}
function start(){items=[];pops=[];score=0;lives=3;combo=0;t=0;spawn=0;px=tx=W/2;running=true;ov.style.display='none';last=performance.now();requestAnimationFrame(loop)}
function end(){running=false;if(score>best){best=score;try{localStorage.setItem('onigiri-best',best)}catch(e){}}
card.innerHTML='<h1>ゲームオーバー</h1><p>スコア: <b style="all:unset;font-size:30px;font-weight:bold">'+score+'</b></p><p>'+(score>=best&&score>0?'🎉 ハイスコア更新!':'ハイスコア: '+best)+'</p><b>もう一回</b>';
setTimeout(()=>{ov.style.display='flex';ov.dataset.ready=1},600)}

function move(e){tx=e.clientX-cv.getBoundingClientRect().left}
cv.addEventListener('pointermove',move);
cv.addEventListener('pointerdown',move);
ov.addEventListener('pointerdown',e=>{e.stopPropagation();if(!running&&(!card.querySelector('h1').textContent.includes('オーバー')||ov.dataset.ready))start()});

function loop(now){
if(!running)return;
const dt=Math.min(0.05,(now-last)/1000);last=now;t+=dt;
const lvl=1+t/20;
px+=(tx-px)*Math.min(1,dt*14);
spawn-=dt;
if(spawn<=0){const k=pick();items.push({k,x:40+Math.random()*(W-80),y:-40,v:(160+Math.random()*80)*lvl,r:Math.random()*6});spawn=Math.max(0.25,0.8/lvl)}
const by=H-70;
for(const it of items){it.y+=it.v*dt;it.r+=dt*2;
 if(!it.done&&it.y>by-30&&it.y<by+30&&Math.abs(it.x-px)<62){it.done=true;
  if(it.k.bomb){lives--;combo=0;shake=0.3;pops.push({x:it.x,y:by-40,s:'💥',a:1})}
  else{combo++;const m=1+Math.floor(combo/5);const p=it.k.pts*m;score+=p;pops.push({x:it.x,y:by-40,s:'+'+p+(m>1?' ×'+m:''),a:1})}}
 else if(!it.done&&it.y>H+40){it.done=true;if(!it.k.bomb)combo=0}}
items=items.filter(i=>!i.done&&i.y<H+60);
for(const p of pops){p.y-=50*dt;p.a-=dt*1.4}pops=pops.filter(p=>p.a>0);
if(shake>0)shake-=dt;
draw(by);
if(lives<=0){end();return}
requestAnimationFrame(loop)}

function draw(by){
ctx.clearRect(0,0,W,H);ctx.save();
if(shake>0)ctx.translate((Math.random()-.5)*14,(Math.random()-.5)*14);
ctx.textAlign='center';ctx.textBaseline='middle';
ctx.font='44px serif';
for(const it of items){ctx.save();ctx.translate(it.x,it.y);ctx.rotate(Math.sin(it.r)*0.4);ctx.fillText(it.k.e,0,0);ctx.restore()}
ctx.font='84px serif';ctx.fillText('🧺',px,by+8);
ctx.font='bold 26px sans-serif';
for(const p of pops){ctx.globalAlpha=Math.max(0,p.a);ctx.fillStyle='#e8452c';ctx.fillText(p.s,p.x,p.y)}
ctx.globalAlpha=1;ctx.restore();
ctx.textAlign='left';ctx.textBaseline='top';ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--ink')||'#000';
ctx.font='bold 30px sans-serif';ctx.fillText('スコア '+score,20,16);
ctx.font='24px sans-serif';ctx.fillText('コンボ '+combo,20,56);
ctx.textAlign='right';ctx.font='30px serif';ctx.fillText('❤️'.repeat(Math.max(0,lives)),W-20,16)}
</script>
</body>
</html>
